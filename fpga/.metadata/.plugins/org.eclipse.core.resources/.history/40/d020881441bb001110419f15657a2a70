#include "server.h"

#include <string.h>

#include "lwip/udp.h"
#include "lwip/ip_addr.h"
#include "lwip/pbuf.h"
#include "lwip/sys.h"
#include "lwip/sockets.h"   /* struct sockaddr_in, AF_INET, htons, ntohs */

#include "protocol.h"

#define MAX_PACKET_DATA_SIZE 1024

/* Максимальная датаграмма, которую мы шлём/принимаем:
   type(1) + frame(4) + start(4) + size(2) + payload(1024) */
#define PACKET_HEADER_SIZE   (1 + 4 + 4 + 2)
#define RX_BUFFER_SIZE       (PACKET_HEADER_SIZE + MAX_PACKET_DATA_SIZE)
#define TX_BUFFER_SIZE       (PACKET_HEADER_SIZE + MAX_PACKET_DATA_SIZE)

/* Минимальный интервал между двумя чанками стрима (мс). */
#define STREAM_INTERVAL_MS   1

/* ============================================================ */

static struct udp_pcb *pcb;
static Broadcast       b;

/* Источник изображения. Указатель, отданный set_image(), валиден
   до следующего вызова set_image(). */
static uint8_t  *imageData      = NULL;
static uint32_t  imageCounter   = 0;   /* ++ на каждый новый кадр */
static uint32_t  lastSentFrame  = 0xFFFFFFFFu;
static uint32_t  lastTickMs     = 0;

/* ============================================================
 *  Мост lwIP -> Addr
 * ============================================================ */

static void AddrFromLwip(Addr *dst, const ip_addr_t *src, u16_t port) {
    memset(dst, 0, sizeof(*dst));
    dst->sin.sin_family      = AF_INET;
    dst->sin.sin_port        = htons(port);
    dst->sin.sin_addr.s_addr = ip4_addr_get_u32(ip_2_ip4(src));
}

/* ============================================================
 *  Низкоуровневая отправка
 * ============================================================ */

static void send_pbuf(struct udp_pcb *pcb, struct pbuf *p,
                      const ip_addr_t *addr, u16_t port) {
    if (!p) return;
    err_t e = udp_sendto(pcb, p, addr, port);
    if (e != ERR_OK) xil_printf("udp_sendto err=%d\r\n", e);
    pbuf_free(p);
}

static void send_packet(const uint8_t *data, uint32_t len, const Addr *dst) {
    if (!data || len == 0) return;

    struct pbuf *p = pbuf_alloc(PBUF_TRANSPORT, (u16_t)len, PBUF_RAM);
    if (!p) return;
    memcpy(p->payload, data, len);

    ip_addr_t ip;
    IP_SET_TYPE_VAL(ip, IPADDR_TYPE_V4);
    ip4_addr_set_u32(ip_2_ip4(&ip), dst->sin.sin_addr.s_addr);

    send_pbuf(pcb, p, &ip, ntohs(dst->sin.sin_port));
}

/* ============================================================
 *  Публичный API
 * ============================================================ */

void set_image(uint8_t *data, uint16_t width, uint16_t height, uint8_t channels) {
    imageData = data;
    imageCounter++;

    b.width    = width;
    b.height   = height;
    b.channels = channels;

    /* Если стрим не идёт — просто держим текущий кадр готовым,
       чтобы handle_get_data мог отвечать на retry-запросы. */
    if (!b.streaming) {
        b.data        = imageData;
        b.frame       = (uint8_t)imageCounter;
        b.offset      = 0;
        lastSentFrame = imageCounter;
    }
}


static void udp_recv_cb(void *arg, struct udp_pcb *tpcb, struct pbuf *p,
                        const ip_addr_t *addr, u16_t port) {
    (void)arg;
    (void)tpcb;
    if (!p) return;

    uint8_t  buf[RX_BUFFER_SIZE];
    uint16_t len = (p->tot_len > sizeof(buf))
                 ? (uint16_t)sizeof(buf)
                 : (uint16_t)p->tot_len;

    pbuf_copy_partial(p, buf, len, 0);
    pbuf_free(p);
    if (len < 1) return;

    Packet req;
    if (Packet_Deserialize(buf, (uint32_t)len, &req) != ERROR_OK)
        return;

    Addr client;
    AddrFromLwip(&client, addr, port);

    Packet res;
    memset(&res, 0, sizeof(res));

    if (Broadcast_Responde(&b, client, &req, &res) != ERROR_OK)
        return;

    /* START/END_STREAM ответа не требуют — Broadcast_Responde
       их обработал, дальше ничего не шлём. */
    if (req.type == PACKET_START_STREAM) {
        /* Синхронизируем сессию с текущим источником. */
        b.data        = imageData;
        b.frame       = (uint8_t)imageCounter;
        b.offset      = 0;
        lastSentFrame = imageCounter;
        lastTickMs    = sys_now();

        xil_printf("stream start -> %s:%d\r\n",
                   ipaddr_ntoa(addr), (int)port);
        return;
    }
    if (req.type == PACKET_END_STREAM) {
        xil_printf("stream stop\r\n");
        return;
    }

    /* GET_STREAM_INFO / GET_STREAM_DATA — формируем ответ */
    uint8_t  txBuf[TX_BUFFER_SIZE];
    uint32_t used = 0;
    if (Packet_Serialize(&res, txBuf, sizeof(txBuf), &used) != ERROR_OK)
        return;

    send_packet(txBuf, used, &client);
}

void start_application(void) {
	err_t err;

	pcb = udp_new();
	if (!pcb) {
		xil_printf("UDP server: Error creating PCB. Out of Memory\r\n");
		return;
	}

	err = udp_bind(pcb, IP_ADDR_ANY, UDP_CONN_PORT);
	if (err != ERR_OK) {
		xil_printf("UDP server: Unable to bind to port");
		xil_printf(" %d: err = %d\r\n", UDP_CONN_PORT, err);
		udp_remove(pcb);
		return;
	}
	xil_printf("UDP server bound to port %d\r\n", UDP_CONN_PORT);

	udp_recv(pcb, udp_recv_cb, NULL);

	return;
}
