#include "server.h"

#include <string.h>

#include "lwip/udp.h"
#include "lwip/ip_addr.h"
#include "lwip/pbuf.h"
#include "lwip/sys.h"

#include "protocol.h"

/* ============================================================
 *  Состояние стрима
 * ============================================================ */

static struct udp_pcb *pcb;

/* Сессия — единственный клиент. Адрес/порт хранит сам Broadcast. */
static Broadcast broadcast;

/* Источник изображения. Указатель валиден до следующего set_image(). */
static uint8_t *imageData      = NULL;
static uint32_t imageCounter   = 0;   /* ++ на каждый новый кадр */
static uint32_t lastSentFrame  = 0xFFFFFFFFu;
static uint32_t lastTickMs     = 0;

/* Скорость стрима: минимум миллисекунд между двумя чанками. */
#define STREAM_INTERVAL_MS  1

/* ============================================================
 *  Мост lwIP <-> Addr из protocol.h
 * ============================================================ */

static void AddrFromLwip(Addr *dst, const ip_addr_t *src, u16_t port) {
    memset(dst, 0, sizeof(*dst));
    dst->sin.sin_family      = AF_INET;
    dst->sin.sin_port        = htons(port);
    dst->sin.sin_addr.s_addr = ip4_addr_get_u32(ip_2_ip4(src));
}

static void SendPacket(const uint8_t *buf, uint32_t len, const Addr *dst) {
    if (len == 0) return;

    struct pbuf *p = pbuf_alloc(PBUF_TRANSPORT, (u16_t)len, PBUF_RAM);
    if (!p) return;

    memcpy(p->payload, buf, len);

    ip_addr_t ip;
    ip4_addr_set_u32(ip_2_ip4(&ip), dst->sin.sin_addr.s_addr);
    IP_SET_TYPE_VAL(ip, IPADDR_TYPE_V4);

    err_t e = udp_sendto(pcb, p, &ip, ntohs(dst->sin.sin_port));
    if (e != ERR_OK) xil_printf("udp_sendto err=%d\r\n", e);

    pbuf_free(p);
}

/* ============================================================
 *  Публичный API
 * ============================================================ */

void set_image(uint8_t *data, uint16_t width, uint16_t height, uint8_t channels) {
    imageData = data;
    imageCounter++;

    /* метаданные нужны, даже если стрим не активен — на запрос INFO */
    broadcast.width     = width;
    broadcast.height    = height;
    broadcast.channels  = channels;
}

/* ============================================================
 *  Обработчики запросов
 * ============================================================ */

static void HandleGetInfo(const ip_addr_t *addr, u16_t port) {
    Packet request  = {0};
    Packet response = {0};
    request.type = PACKET_GET_STREAM_INFO;

    Addr from;
    AddrFromLwip(&from, addr, port);

    if (Broadcast_Responde(&broadcast, from, &request, &response) != ERROR_OK)
        return;

    uint8_t txBuffer[64];
    uint32_t used = 0;
    if (Packet_Serialize(&response, txBuffer, sizeof(txBuffer), &used) != ERROR_OK)
        return;

    SendPacket(txBuffer, used, &from);
}

static void HandleStartStream(const ip_addr_t *addr, u16_t port) {
    Packet request = {0};
    request.type = PACKET_START_STREAM;

    Addr from;
    AddrFromLwip(&from, addr, port);

    Broadcast_Responde(&broadcast, from, &request, NULL);

    /* Broadcast_Responde(START_STREAM) обнуляет frame и НЕ трогает offset,
       поэтому явно синхронизируем состояние с текущим источником. */
    broadcast.data      = imageData;
    broadcast.frame     = (uint8_t)imageCounter;
    broadcast.offset    = 0;
    lastSentFrame       = imageCounter;
    lastTickMs          = sys_now();

    xil_printf("stream start -> %s:%d\r\n", ipaddr_ntoa(addr), (int)port);
}

static void HandleEndStream(void) {
    Packet request = {0};
    request.type = PACKET_END_STREAM;

    Addr dummy = {0};
    Broadcast_Responde(&broadcast, dummy, &request, NULL);

    xil_printf("stream stop\r\n");
}

static void HandleGetData(const ip_addr_t *addr, u16_t port,
                          const uint8_t *rxBuffer, uint16_t rxLen) {
    Packet request;
    if (Packet_Deserialize(rxBuffer, rxLen, &request) != ERROR_OK)
        return;
    if (request.type != PACKET_GET_STREAM_DATA)
        return;

    Addr from;
    AddrFromLwip(&from, addr, port);

    Packet response;
    if (Broadcast_Responde(&broadcast, from, &request, &response) != ERROR_OK)
        return;

    /* ответ содержит указатель внутрь broadcast.data (zero-copy) —
       сериализуем в локальный буфер, потом шлём */
    static uint8_t txBuffer[1 + 10 + MAX_PACKET_DATA_SIZE];
    uint32_t used = 0;
    if (Packet_Serialize(&response, txBuffer, sizeof(txBuffer), &used) != ERROR_OK)
        return;

    SendPacket(txBuffer, used, &from);
}

/* ============================================================
 *  UDP-приём
 * ============================================================ */

static void UdpRecvCallback(void *arg, struct udp_pcb *tpcb,
                            struct pbuf *p,
                            const ip_addr_t *addr, u16_t port) {
    (void)arg;
    (void)tpcb;
    if (!p) return;

    static uint8_t rxBuffer[1 + 10 + MAX_PACKET_DATA_SIZE];
    uint16_t len = (p->tot_len > sizeof(rxBuffer))
                   ? (uint16_t)sizeof(rxBuffer)
                   : (uint16_t)p->tot_len;

    pbuf_copy_partial(p, rxBuffer, len, 0);
    pbuf_free(p);
    if (len < 1) return;

    switch (rxBuffer[0]) {
        case PACKET_GET_STREAM_INFO:  HandleGetInfo(addr, port);           break;
        case PACKET_START_STREAM:     HandleStartStream(addr, port);       break;
        case PACKET_END_STREAM:       HandleEndStream();                   break;
        case PACKET_GET_STREAM_DATA:  HandleGetData(addr, port, rxBuffer, len); break;
        default: break;
    }
}

/* ============================================================
 *  Периодический tick — вызывать из главного цикла
 * ============================================================ */

void server_tick(void) {
    if (!broadcast.streaming) return;
    if (!broadcast.data)      return;

    uint32_t now = sys_now();
    if (now - lastTickMs < STREAM_INTERVAL_MS) return;
    lastTickMs = now;

    uint32_t frameSize = (uint32_t)broadcast.width
                       * (uint32_t)broadcast.height
                       * (uint32_t)broadcast.channels;
    if (frameSize == 0) return;

    /* Текущий кадр отдан → переключаемся на новый, если он есть. */
    if (broadcast.offset >= frameSize) {
        if (lastSentFrame == imageCounter) return;   /* ждём новый кадр */
        broadcast.data   = imageData;
        broadcast.frame  = (uint8_t)imageCounter;
        broadcast.offset = 0;
        lastSentFrame    = imageCounter;
    }

    Packet chunk;
    if (Broadcast_Sream(&broadcast, &chunk) != ERROR_OK) return;

    static uint8_t txBuffer[1 + 10 + MAX_PACKET_DATA_SIZE];
    uint32_t used = 0;
    if (Packet_Serialize(&chunk, txBuffer, sizeof(txBuffer), &used) != ERROR_OK)
        return;

