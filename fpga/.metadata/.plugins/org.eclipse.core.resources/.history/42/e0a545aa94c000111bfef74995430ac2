#ifndef PROTOCOL_H
#define PROTOCOL_H

#include <stdint.h>

#include "error.h"

#define MAX_PACKET_DATA_SIZE 1024

typedef enum {
	PACKET_NONE,
	PACKET_GET_STREAM_INFO,
	PACKET_SET_STREAM_INFO,
	PACKET_START_STREAM,
	PACKET_END_STREAM,
	PACKET_GET_STREAM_DATA,
	PACKET_SET_STREAM_DATA
} PacketType;

typedef struct {
	uint16_t width;
	uint16_t height;
	uint8_t channels;
} PacketInfo;

typedef struct {
	uint32_t frame;
	uint32_t start;
	uint16_t size;
	uint8_t *data;
} PacketData;

typedef struct {
	PacketType type;
	union {
		PacketInfo info;
		PacketData data;
	};
} Packet;

Error Packet_Serialize(const Packet *p, uint8_t *buff, uint32_t size, uint32_t *sizeUsed);
Error Packet_Deserialize(const uint8_t *buff, uint32_t size, Packet *p);

typedef struct {
	uint16_t width;
	uint16_t height;
	uint8_t channels;
	uint8_t frame;
	uint32_t offset;
	uint8_t *data;
	uint8_t  streaming;
	Addr addr;
} Broadcast;

Error Broadcast_Responde(Broadcast *b, Addr addr, const Packet *req, Packet *res);
Error Broadcast_Stream(Broadcast *b, Packet *p);
Error Broadcast_Receive(Broadcast *b, const Packet *p, int *frameReceived, Packet *request);

#endif
